{
  "openapi": "3.1.0",
  "info": {
    "title": "电信客服 Agent v1",
    "version": "0.1.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "服务密码登录 → 颁发 access/refresh token；成功/失败均记审计日志（CONTEXT › 审计日志）。",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Read Current User",
        "description": "返回当前认证客户的公开档案（受保护端点）。\n\nresponse_model=CustomerPublic 负责过滤敏感字段（service_password_hash 等）。\nPRD 依据：实现决策 › 认证与会话；循环4（验收3）。",
        "operationId": "read_current_user_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerPublic"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/auth/reauth": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Reauth",
        "description": "办理执行复核：再次校验服务密码 → 颁发短期 execute_token。\n\nCONTEXT › 办理执行复核 (Transaction Re-auth)：办理类 Ticket 执行前的补偿控制。\n受 access token 保护（current 已认证），此处复核服务密码本身；成功/失败均记审计。\nPRD 依据：实现决策 › 认证与会话 / 办理执行复核；循环5（验收4）。",
        "operationId": "reauth_auth_reauth_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReauthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReauthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/conversations": {
      "get": {
        "tags": [
          "conversation"
        ],
        "summary": "List Conversations",
        "description": "当前客户的会话列表（未认证 401 由 CurrentCustomer 守卫）。",
        "operationId": "list_conversations_conversations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConversationOut"
                  },
                  "type": "array",
                  "title": "Response List Conversations Conversations Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/conversations/{conversation_id}/messages": {
      "get": {
        "tags": [
          "conversation"
        ],
        "summary": "List Messages",
        "description": "会话消息历史；会话不存在或不属于当前客户 → 404（不泄露存在性）。",
        "operationId": "list_messages_conversations__conversation_id__messages_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MessageOut"
                  },
                  "title": "Response List Messages Conversations  Conversation Id  Messages Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/general-info/search": {
      "get": {
        "tags": [
          "general-info"
        ],
        "summary": "Search",
        "description": "RAG 检索知识库（政策/规则/手册）；无匹配返回空列表（不编造）。",
        "operationId": "search_general_info_search_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Query"
            }
          },
          {
            "name": "k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3,
              "title": "K"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KnowledgeDocumentOut"
                  },
                  "title": "Response Search General Info Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/general-info/plans": {
      "get": {
        "tags": [
          "general-info"
        ],
        "summary": "Plans",
        "description": "套餐目录查询（结构化数据）：?names=a&names=b 或 ?name=x 过滤。",
        "operationId": "plans_general_info_plans_get",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Name"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Names"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlanOut"
                  },
                  "title": "Response Plans General Info Plans Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/general-info/coverage": {
      "get": {
        "tags": [
          "general-info"
        ],
        "summary": "Coverage",
        "description": "网络覆盖查询（结构化数据）：按区域名模糊匹配。",
        "operationId": "coverage_general_info_coverage_get",
        "parameters": [
          {
            "name": "area",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Area"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CoverageAreaOut"
                  },
                  "title": "Response Coverage General Info Coverage Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/general-info/halls": {
      "get": {
        "tags": [
          "general-info"
        ],
        "summary": "Halls",
        "description": "营业厅查询（结构化数据）：按行政区过滤。",
        "operationId": "halls_general_info_halls_get",
        "parameters": [
          {
            "name": "district",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "District"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BusinessHallOut"
                  },
                  "title": "Response Halls General Info Halls Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BusinessHallOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "district": {
            "type": "string",
            "title": "District"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "business_hours": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Business Hours"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "district",
          "address",
          "phone",
          "business_hours"
        ],
        "title": "BusinessHallOut",
        "description": "营业厅项（名称/行政区/地址/营业时间）。"
      },
      "ConversationOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "customer_id",
          "status",
          "created_at"
        ],
        "title": "ConversationOut",
        "description": "会话列表项。"
      },
      "CoverageAreaOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "area": {
            "type": "string",
            "title": "Area"
          },
          "network_type": {
            "type": "string",
            "title": "Network Type"
          },
          "level": {
            "type": "string",
            "title": "Level"
          }
        },
        "type": "object",
        "required": [
          "id",
          "area",
          "network_type",
          "level"
        ],
        "title": "CoverageAreaOut",
        "description": "网络覆盖项（4G/5G 覆盖等级）。"
      },
      "CustomerPublic": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "phone"
        ],
        "title": "CustomerPublic",
        "description": "当前客户公开档案（/auth/me 响应）。\n\n仅暴露非敏感字段；service_password_hash 等绝不外泄。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KnowledgeDocumentOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "id",
          "category",
          "title",
          "content"
        ],
        "title": "KnowledgeDocumentOut",
        "description": "RAG 检索结果（知识库原文，不编造）。"
      },
      "LoginRequest": {
        "properties": {
          "phone": {
            "type": "string",
            "title": "Phone",
            "description": "手机号（11 位）"
          },
          "service_password": {
            "type": "string",
            "title": "Service Password",
            "description": "服务密码"
          }
        },
        "type": "object",
        "required": [
          "phone",
          "service_password"
        ],
        "title": "LoginRequest"
      },
      "MessageOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "conversation_id": {
            "type": "integer",
            "title": "Conversation Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "conversation_id",
          "source",
          "content",
          "created_at"
        ],
        "title": "MessageOut",
        "description": "消息历史项。source 四类分类由循环3 约束，此处仅透传。"
      },
      "PlanOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "data_allowance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Allowance"
          },
          "call_minutes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Call Minutes"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "price",
          "data_allowance",
          "call_minutes",
          "description"
        ],
        "title": "PlanOut",
        "description": "套餐目录项（结构化数据 / 资费表）。"
      },
      "ReauthRequest": {
        "properties": {
          "service_password": {
            "type": "string",
            "title": "Service Password",
            "description": "办理执行复核用服务密码"
          }
        },
        "type": "object",
        "required": [
          "service_password"
        ],
        "title": "ReauthRequest"
      },
      "ReauthResponse": {
        "properties": {
          "execute_token": {
            "type": "string",
            "title": "Execute Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "execute_token"
        ],
        "title": "ReauthResponse",
        "description": "办理执行复核通过后颁发的短期可执行凭证。"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "TokenResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
